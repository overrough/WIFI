# ============================================================
# JARVIS — Environment Configuration
# Copy this to .env and fill in your values.
# Everything marked "FREE" works with no API key.
# ============================================================

# ── LLM Providers ──────────────────────────────────────────
# FREE default: Ollama (local). Install from ollama.com, then:
#   ollama pull llama3.2
# Set LLM_PROVIDER=anthropic or openai to use cloud models.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Alternative (also excellent, slightly less RAM): OLLAMA_MODEL=gemma3:12b

# Cloud providers (optional — better quality, small cost)
# Cheapest Anthropic: claude-haiku-4-5-20251001 (~$0.001/message)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Cheapest OpenAI: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Voice — STT (FREE, local) ──────────────────────────────
# faster-whisper runs locally, no key needed.
# Model sizes: tiny (fast) | base (default) | small | medium | large-v3 (best)
WHISPER_MODEL=base

# ── Voice — TTS ────────────────────────────────────────────
# FREE default: edge-tts (Microsoft neural voices, no key needed)
# To see all voices: python -c "import asyncio,edge_tts; asyncio.run(edge_tts.list_voices())"
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-GuyNeural

# Optional premium TTS: ElevenLabs (free tier: 10,000 chars/month)
# Set TTS_PROVIDER=elevenlabs to enable
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# NOTE: Sarvam STT/TTS are paid (₹30/hr). Stick with faster-whisper + edge-tts above.

# ── Voice — Wake Word (FREE, local) ────────────────────────
# Say "Jarvis" or double-clap to activate. Both work offline.
# Lower = more sensitive (more false positives). Range: 0.0–1.0
WAKE_WORD_SENSITIVITY=0.5
# How loud a clap must be (0.0–1.0). Lower = more sensitive.
CLAP_RMS_THRESHOLD=0.15

# ── Google Calendar & Gmail (FREE via OAuth) ───────────────
# One-time setup (~5 min):
#   1. console.cloud.google.com → New project
#   2. Enable: Google Calendar API + Gmail API
#   3. OAuth consent screen → External → add your email as test user
#   4. Credentials → OAuth 2.0 Client ID → Desktop → download JSON
#   5. Save as backend/google_credentials.json
#   6. First run opens browser to authorize. Token saved automatically.
GOOGLE_CREDENTIALS_FILE=./google_credentials.json
GOOGLE_TOKEN_FILE=./google_token.json

# ── Search ─────────────────────────────────────────────────
# FREE default: DuckDuckGo (no key needed, always works)
# Optional upgrades for richer/faster results:
TAVILY_API_KEY=      # tavily.com — free tier: 1,000 searches/month
SERPER_API_KEY=      # serper.dev — free tier: 2,500 searches/month

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://jarvis:localdev@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379

# ── App Config ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-string-in-production
JARVIS_DEFAULT_MODE=work
JARVIS_USER_NAME=Boss
JARVIS_TIMEZONE=Asia/Kolkata
JARVIS_API_KEY=local-dev-key
CHROMA_PERSIST_DIR=./chroma_data

# ── Automation Webhooks (optional) ─────────────────────────
ZAPIER_WEBHOOK_BASE=
N8N_WEBHOOK_BASE=
